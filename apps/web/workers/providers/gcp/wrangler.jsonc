{
  "$schema": "../../../../../node_modules/wrangler/config-schema.json",
  "name": "intar-provider-gcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": [
      "GCP_PROVIDER_CREDENTIAL_KEK_V1",
      "GCP_CATALOG_API_KEY"
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GCP_CONNECTIONS",
        "class_name": "GcpConnectionDO"
      }
    ]
  },
  "exports": {
    "GcpConnectionDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
