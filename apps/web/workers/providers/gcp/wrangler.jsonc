{
  "$schema": "../../../../../node_modules/wrangler/config-schema.json",
  "name": "intar-provider-gcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "GCP_PROVIDER_MODE": "dormant"
  },
  "secrets": {
    "required": [
      "GCP_PROVIDER_CREDENTIAL_KEK_V1"
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GCP_CONNECTIONS",
        "class_name": "GcpConnectionDO"
      }
    ]
  },
  "exports": {
    "GcpConnectionDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
