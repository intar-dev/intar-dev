{
  "name": "@intar/provider-gcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "types:cf": "wrangler types worker-configuration.d.ts --env-interface Env --include-runtime false",
    "types:cf:check": "wrangler types worker-configuration.d.ts --env-interface Env --include-runtime false --check",
    "build": "bun run check && wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@intar/provider-contracts": "workspace:*",
    "@intar/provider-worker-core": "workspace:*",
    "@intar/workshop-contracts": "workspace:*"
  },
  "devDependencies": {
    "@intar/provider-testkit": "workspace:*",
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
