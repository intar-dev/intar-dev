{
  "$schema": "../../../../../node_modules/wrangler/config-schema.json",
  "name": "intar-provider-hetzner",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["HETZNER_PROVIDER_CREDENTIAL_KEK_V1"],
  },
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HETZNER_CONNECTIONS",
        "class_name": "HetznerConnectionDO",
      },
    ],
  },
  "exports": {
    "HetznerConnectionDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
