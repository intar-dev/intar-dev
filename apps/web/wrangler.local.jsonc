{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "intar-dev-local",
  "main": "src/worker.ts",
  "vars": {
    "BETTER_AUTH_APP_NAME": "intar.dev local",
    "BETTER_AUTH_URL": "http://localhost:4321",
    "AGENT_JWT_ISSUER": "intar-agent-bridge",
    "AGENT_JWT_AUDIENCE": "agent-connect",
    "STARGATE_ROUTE_TTL_SECONDS": "14400",
    "STARGATE_ADMIN_AUTH_HEADER": "cf-access-jwt-assertion",
    "STARGATE_ADMIN_AUTH_ISSUER": "intar.dev",
    "STARGATE_ADMIN_AUTH_AUDIENCE": "stargate-admin",
    "GITHUB_APP_CLIENT_ID": "",
    "GITHUB_APP_SLUG": "",
    "PUBLIC_SCENARIO_SOURCE_REPOSITORY_ID": "",
    "SCENARIO_PUBLISH_WORKFLOW_SHAS": "",
    "SCENARIO_COMPILER_CLI_VERSION": "",
    "SCENARIO_COMPILER_CLI_SHA256": "",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "database_name": "intar-dev-local",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "VM_IMAGE_REGISTRY_BUCKET",
      "bucket_name": "intar-dev-local-vm-image-registry",
    },
    {
      // Public run shares, served to viewers from the CDN by a custom domain
      // (SHARE_LIVE_ORIGIN). Holds only what owners chose to share.
      "binding": "SHARE_LIVE_BUCKET",
      "bucket_name": "intar-dev-share-live-20261005",
      "jurisdiction": "eu",
    },
    {
      "binding": "VM_RUN_ARTIFACTS_BUCKET",
      "bucket_name": "intar-dev-local-run-artifacts",
    },
  ],
  "services": [
    {
      "binding": "REGISTRY_CLEANUP",
      "service": "intar-dev-image-registry-cleanup-local",
      "entrypoint": "RegistryCleanup",
    },
  ],
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "12f35c20-55f4-47ee-8b31-b3ad202d1f04",
      "remote": true,
    },
  ],
  "ratelimits": [
    {
      "name": "ACCESS_INVITE_RATE_LIMITER",
      "namespace_id": "88427091",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
    {
      // Registry token exchanges per client IP; content reads are not limited.
      "name": "REGISTRY_TOKEN_RATE_LIMITER",
      "namespace_id": "88427092",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOST_RUNTIME",
        "class_name": "HostRuntimeDO",
      },
      {
        "name": "SCENARIO_SOURCE",
        "class_name": "ScenarioSourceDO",
      },
      {
        // One per public run share, named by its share id in the EU
        // jurisdiction: the share's terminal log, written once, read by
        // every viewer.
        "name": "RUN_SHARE",
        "class_name": "RunShareDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v3",
      "new_sqlite_classes": ["HostRuntimeDO"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["ScenarioSourceDO"],
    },
    {
      // A revert that stops exporting RunShareDO must add a
      // `deleted_classes: ["RunShareDO"]` migration in the same deploy.
      "tag": "v6",
      "new_sqlite_classes": ["RunShareDO"],
    },
  ],
}
