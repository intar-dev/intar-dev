{
  "name": "@intar/website",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun run types:cf:check && astro check && astro build",
    "build:deploy": "astro build",
    "ui:bundle:check": "bun scripts/check-ui-bundle.ts",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:node": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "ui:install": "playwright install --with-deps chromium firefox webkit",
    "test:ui": "playwright test",
    "test:ui:perf": "playwright test tests/ui/performance.spec.ts --project=chromium-performance",
    "test:ui:visual": "playwright test tests/ui/routes.visual.spec.ts tests/ui/dense.visual.spec.ts tests/ui/states.visual.spec.ts --project=chromium-ui",
    "test:ui:visual:update": "playwright test tests/ui/routes.visual.spec.ts tests/ui/dense.visual.spec.ts tests/ui/states.visual.spec.ts --project=chromium-ui --update-snapshots",
    "test:ui:a11y": "playwright test tests/ui/routes.a11y.spec.ts tests/ui/states.a11y.spec.ts tests/ui/interaction.a11y.spec.ts --project=chromium-ui",
    "test:ui:smoke": "playwright test tests/ui/smoke.spec.ts",
    "types:cf": "wrangler types worker-configuration.d.ts --env-interface WorkerEnv --include-runtime false --env-file .env.types",
    "types:cf:check": "wrangler types worker-configuration.d.ts --env-interface WorkerEnv --include-runtime false --env-file .env.types --check",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && bun ../../tools/database/prune-drizzle-snapshots.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate:production": "DRIZZLE_D1_HTTP=1 drizzle-kit migrate --config drizzle.config.ts",
    "db:schema:check": "tsc --noEmit -p tsconfig.provider-runtime-schema.json && vitest run src/lib/workshops/runtime-provider.test.ts && vitest run --config vitest.workers.config.ts src/db/schema.workers.test.ts"
  },
  "dependencies": {
    "@intar/provider-contracts": "workspace:*",
    "@intar/workshop-contracts": "workspace:*",
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/react": "^6.0.1",
    "@base-ui/react": "^1.6.0",
    "@better-auth/core": "1.7.0-beta.10",
    "@better-auth/oauth-provider": "1.7.0-beta.10",
    "@better-auth/sso": "1.7.0-beta.10",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.2.6",
    "@fontsource-variable/recursive": "^5.2.8",
    "@noble/curves": "^2.2.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "asciinema-player": "^3.17.0",
    "astro": "^7.2.4",
    "better-auth": "1.7.0-beta.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "drizzle-kit": "0.31.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
