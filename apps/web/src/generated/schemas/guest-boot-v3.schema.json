{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuestBootV3",
  "description": "`boot.json`: everything one VM's Kino is told. The host writes it onto\nthe read-only run disk.",
  "type": "object",
  "properties": {
    "contract": {
      "type": "integer",
      "format": "uint32",
      "maximum": 3,
      "minimum": 3
    },
    "host": {
      "description": "Where Kino reaches the host for its reports and the run CLI's broker.\nAbsent, it is the host's vsock CID, as on every agent host; a host\nthat leaves it out writes the same bytes as before the field existed.",
      "anyOf": [
        {
          "$ref": "#/$defs/GuestHostV3"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostname": {
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/SpecMode"
    },
    "network": {
      "$ref": "#/$defs/GuestNetworkV3"
    },
    "peers": {
      "description": "Machine name to address, for `/etc/hosts`.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ready_seconds": {
      "description": "Seconds the lab's ready scripts get in total, when the host knows the\nguest is slower than a learner's: an image build that boots what it\nbuilt under emulation. Absent, Kino's own limit applies, as for every\nrun of a lab; a host that leaves it out writes the same bytes as\nbefore the field existed. A Kino older than the field refuses a\n`boot.json` that has it.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 3600,
      "minimum": 1
    },
    "root_resize": {
      "type": "boolean"
    },
    "spec": {
      "$ref": "#/$defs/MachineSpecV1"
    },
    "ssh": {
      "$ref": "#/$defs/GuestSshV3"
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "hostname",
    "network",
    "peers",
    "ssh",
    "root_resize",
    "mode",
    "spec"
  ],
  "$defs": {
    "GuestHostV3": {
      "description": "The host's end of Kino's two connections.",
      "oneOf": [
        {
          "description": "AF_VSOCK to the host's CID, on [`REPORT_PORT`] and [`RUN_CLI_PORT`].",
          "type": "object",
          "properties": {
            "transport": {
              "type": "string",
              "const": "vsock"
            }
          },
          "additionalProperties": false,
          "required": [
            "transport"
          ]
        },
        {
          "description": "TCP to this IP address, for a host without vsock: a learner's own\ncomputer running macOS or Windows. The ports are the host's choice,\nsince every guest there reaches it at the same address and only the\nport tells two machines apart.",
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "report_port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 1
            },
            "run_cli_port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 1
            },
            "transport": {
              "type": "string",
              "const": "tcp"
            }
          },
          "additionalProperties": false,
          "required": [
            "transport",
            "address",
            "report_port",
            "run_cli_port"
          ]
        }
      ]
    },
    "GuestNetworkV3": {
      "type": "object",
      "properties": {
        "dns": {
          "description": "Empty unless the machine has egress; peers resolve from `/etc/hosts`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gateway": {
          "type": "string"
        },
        "ip_cidr": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "ip_cidr",
        "gateway",
        "dns"
      ]
    },
    "GuestSshV3": {
      "type": "object",
      "properties": {
        "authorized_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "authorized_keys"
      ]
    },
    "MachineSpecV1": {
      "description": "What one machine's Kino runs. A learn spec holds no solve script and no\nother machine's scripts.",
      "type": "object",
      "properties": {
        "defer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "machine": {
          "type": "string"
        },
        "ready": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScriptV1"
          }
        },
        "scenario_id": {
          "description": "`<org-slug>/<scenario-slug>`; empty on a build boot.",
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecTaskV1"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "machine",
        "env",
        "defer",
        "ready",
        "tasks"
      ]
    },
    "ProbeCheckV1": {
      "description": "A check Kino evaluates itself instead of running a script.",
      "type": "object",
      "properties": {
        "fail": {
          "description": "The learner message when it fails, instead of Kino's own.",
          "type": [
            "string",
            "null"
          ]
        },
        "probe": {
          "$ref": "#/$defs/ProbeV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "probe"
      ]
    },
    "ProbeV1": {
      "description": "A question to the machine's Kubernetes API, asked with the kubeconfig\nthat `KUBECONFIG` in the machine's env names (else `~/.kube/config`).",
      "oneOf": [
        {
          "description": "An object exists and, with `path`, a JSONPath in it matches exactly\none value, equal to `equals` when that is set: a string as it is,\nanything else as compact JSON.",
          "type": "object",
          "properties": {
            "equals": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "k8s"
            },
            "namespace": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "target": {
              "description": "`<resource>/<name>`, as kubectl takes it: `deployment/web`.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        },
        {
          "description": "A Deployment's current generation is observed and all its replicas\nare updated, Ready and available; `replicas` is the count it must want.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rollout"
            },
            "namespace": {
              "type": [
                "string",
                "null"
              ]
            },
            "replicas": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "target": {
              "description": "`deployment/<name>`.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        },
        {
          "description": "A SubjectAccessReview per verb: `user` with `groups` may (or, with\n`allowed` false, may not) do each verb on `resource`.",
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "can_i"
            },
            "namespace": {
              "type": [
                "string",
                "null"
              ]
            },
            "resource": {
              "description": "`<plural>[.<group>][/<subresource>]`: `pods`, `deployments.apps`.",
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "verbs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "verbs",
            "resource",
            "user",
            "groups",
            "allowed"
          ]
        }
      ]
    },
    "ScriptV1": {
      "description": "A named lowered bash script: a setup stage or a ready block.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "script": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "script"
      ]
    },
    "SpecMode": {
      "type": "string",
      "enum": [
        "learn",
        "verify"
      ]
    },
    "SpecTaskV1": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "needs": {
          "description": "A need on another machine is `<machine>/<task-id>`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "probes": {
          "description": "Evaluated by Kino, in order, before `check`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProbeCheckV1"
          }
        },
        "solve": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "check",
        "needs"
      ]
    }
  }
}
