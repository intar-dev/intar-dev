{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuestBootV3",
  "description": "`boot.json`: everything one VM's Kino is told. The host writes it onto\nthe read-only run disk.",
  "type": "object",
  "properties": {
    "contract": {
      "type": "integer",
      "format": "uint32",
      "maximum": 3,
      "minimum": 3
    },
    "host": {
      "description": "Where Kino reaches the host for its reports and the run CLI's broker.\nAbsent, it is the host's vsock CID, as on every agent host; a host\nthat leaves it out writes the same bytes as before the field existed.",
      "anyOf": [
        {
          "$ref": "#/$defs/GuestHostV3"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostname": {
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/SpecMode"
    },
    "network": {
      "$ref": "#/$defs/GuestNetworkV3"
    },
    "peers": {
      "description": "Machine name to address, for `/etc/hosts`.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "root_resize": {
      "type": "boolean"
    },
    "spec": {
      "$ref": "#/$defs/MachineSpecV1"
    },
    "ssh": {
      "$ref": "#/$defs/GuestSshV3"
    }
  },
  "additionalProperties": false,
  "required": [
    "contract",
    "hostname",
    "network",
    "peers",
    "ssh",
    "root_resize",
    "mode",
    "spec"
  ],
  "$defs": {
    "GuestHostV3": {
      "description": "The host's end of Kino's two connections.",
      "oneOf": [
        {
          "description": "AF_VSOCK to the host's CID, on [`REPORT_PORT`] and [`RUN_CLI_PORT`].",
          "type": "object",
          "properties": {
            "transport": {
              "type": "string",
              "const": "vsock"
            }
          },
          "additionalProperties": false,
          "required": [
            "transport"
          ]
        },
        {
          "description": "TCP to this IP address, for a host without vsock: a learner's own\ncomputer running macOS or Windows. The ports are the host's choice,\nsince every guest there reaches it at the same address and only the\nport tells two machines apart.",
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "report_port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 1
            },
            "run_cli_port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 1
            },
            "transport": {
              "type": "string",
              "const": "tcp"
            }
          },
          "additionalProperties": false,
          "required": [
            "transport",
            "address",
            "report_port",
            "run_cli_port"
          ]
        }
      ]
    },
    "GuestNetworkV3": {
      "type": "object",
      "properties": {
        "dns": {
          "description": "Empty unless the machine has egress; peers resolve from `/etc/hosts`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gateway": {
          "type": "string"
        },
        "ip_cidr": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "ip_cidr",
        "gateway",
        "dns"
      ]
    },
    "GuestSshV3": {
      "type": "object",
      "properties": {
        "authorized_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "authorized_keys"
      ]
    },
    "MachineSpecV1": {
      "description": "What one machine's Kino runs. A learn spec holds no solve script and no\nother machine's scripts.",
      "type": "object",
      "properties": {
        "defer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "machine": {
          "type": "string"
        },
        "ready": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScriptV1"
          }
        },
        "scenario_id": {
          "description": "`<org-slug>/<scenario-slug>`; empty on a build boot.",
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpecTaskV1"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "machine",
        "env",
        "defer",
        "ready",
        "tasks"
      ]
    },
    "ScriptV1": {
      "description": "A named lowered bash script: a setup stage or a ready block.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "script": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "script"
      ]
    },
    "SpecMode": {
      "type": "string",
      "enum": [
        "learn",
        "verify"
      ]
    },
    "SpecTaskV1": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "needs": {
          "description": "A need on another machine is `<machine>/<task-id>`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "solve": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "check",
        "needs"
      ]
    }
  }
}
