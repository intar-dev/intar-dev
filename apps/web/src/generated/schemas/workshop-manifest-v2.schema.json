{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HydratedWorkshopManifestV2",
  "type": "object",
  "properties": {
    "agenda": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HydratedAgendaItem"
      }
    },
    "durationMinutes": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HydratedModule"
      }
    },
    "presentation": {
      "$ref": "#/$defs/HydratedPresentation"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint8",
      "maximum": 2,
      "minimum": 2
    },
    "workshop": {
      "$ref": "#/$defs/HydratedWorkshop"
    },
    "workspace": {
      "$ref": "#/$defs/HydratedWorkspace"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workshop",
    "workspace",
    "modules",
    "agenda",
    "presentation",
    "durationMinutes"
  ],
  "$defs": {
    "HydratedAgendaItem": {
      "type": "object",
      "properties": {
        "durationMinutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "moduleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "type": "string"
        },
        "scheduled": {
          "type": "boolean"
        },
        "slideIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "durationMinutes",
        "scheduled",
        "slideIds",
        "release"
      ]
    },
    "HydratedAttribution": {
      "type": "object",
      "properties": {
        "license": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "license"
      ]
    },
    "HydratedCheckpoint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "vmImages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HydratedVmImage"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "vmImages"
      ]
    },
    "HydratedGcpRootDiskType": {
      "type": "string",
      "enum": [
        "pd-balanced"
      ]
    },
    "HydratedHint": {
      "type": "object",
      "properties": {
        "bodyMarkdown": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "bodyMarkdown"
      ]
    },
    "HydratedModule": {
      "type": "object",
      "properties": {
        "catchUpCheckpointId": {
          "type": "string"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explainBackPrompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "facilitatorNotesMarkdown": {
          "type": "string"
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HydratedHint"
          }
        },
        "id": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "participantMarkdown": {
          "type": "string"
        },
        "probeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "solutionMarkdown": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "tier",
        "outcome",
        "dependsOn",
        "participantMarkdown",
        "facilitatorNotesMarkdown",
        "hints",
        "solutionMarkdown",
        "probeIds",
        "catchUpCheckpointId"
      ]
    },
    "HydratedPresentation": {
      "type": "object",
      "properties": {
        "slides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HydratedSlide"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "slides"
      ]
    },
    "HydratedRuntimeArchitecture": {
      "type": "string",
      "enum": [
        "x86_64"
      ]
    },
    "HydratedRuntimeHardware": {
      "type": "object",
      "properties": {
        "architecture": {
          "$ref": "#/$defs/HydratedRuntimeArchitecture"
        },
        "cpuMillis": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "diskMib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "memoryMib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "providerCpuCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "architecture",
        "cpuMillis",
        "providerCpuCount",
        "memoryMib",
        "diskMib"
      ]
    },
    "HydratedRuntimeProfile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "hardware": {
              "$ref": "#/$defs/HydratedRuntimeHardware"
            },
            "id": {
              "type": "string"
            },
            "immutableSystemImage": {
              "type": "string"
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "provider": {
              "type": "string",
              "const": "agent_kvm"
            },
            "requestedSystemImage": {
              "type": "string"
            },
            "vmId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "provider",
            "id",
            "vmId",
            "requestedSystemImage",
            "immutableSystemImage",
            "locations",
            "hardware"
          ]
        },
        {
          "type": "object",
          "properties": {
            "hardware": {
              "$ref": "#/$defs/HydratedRuntimeHardware"
            },
            "id": {
              "type": "string"
            },
            "immutableSystemImage": {
              "type": "string"
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "machineType": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "const": "hetzner_cloud"
            },
            "requestedSystemImage": {
              "type": "string"
            },
            "vmId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "provider",
            "id",
            "vmId",
            "machineType",
            "requestedSystemImage",
            "immutableSystemImage",
            "locations",
            "hardware"
          ]
        },
        {
          "type": "object",
          "properties": {
            "hardware": {
              "$ref": "#/$defs/HydratedRuntimeHardware"
            },
            "id": {
              "type": "string"
            },
            "immutableSystemImage": {
              "type": "string"
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "machineType": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "const": "gcp_compute"
            },
            "requestedSystemImage": {
              "type": "string"
            },
            "rootDiskType": {
              "$ref": "#/$defs/HydratedGcpRootDiskType"
            },
            "vmId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "provider",
            "id",
            "vmId",
            "machineType",
            "requestedSystemImage",
            "immutableSystemImage",
            "rootDiskType",
            "locations",
            "hardware"
          ]
        }
      ]
    },
    "HydratedSlide": {
      "type": "object",
      "properties": {
        "bodyMarkdown": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "layout": {
          "type": "string"
        },
        "moduleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "notesMarkdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "layout",
        "title",
        "bodyMarkdown"
      ]
    },
    "HydratedVmImage": {
      "type": "object",
      "properties": {
        "imageKey": {
          "$ref": "#/$defs/ImageKey"
        },
        "imageSha256": {
          "type": "string"
        },
        "vmId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "vmId",
        "imageKey",
        "imageSha256"
      ]
    },
    "HydratedWorkshop": {
      "type": "object",
      "properties": {
        "attribution": {
          "$ref": "#/$defs/HydratedAttribution"
        },
        "defaultLobbyMinutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slug": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "slug",
        "title",
        "summary",
        "prerequisites",
        "attribution",
        "defaultLobbyMinutes"
      ]
    },
    "HydratedWorkspace": {
      "type": "object",
      "properties": {
        "applications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HydratedWorkspaceApplication"
          }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HydratedCheckpoint"
          }
        },
        "initialCheckpointId": {
          "type": "string"
        },
        "leaseGraceMinutes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "runtimeProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HydratedRuntimeProfile"
          }
        },
        "vms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HydratedWorkspaceVm"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "leaseGraceMinutes",
        "vms",
        "runtimeProfiles",
        "checkpoints",
        "initialCheckpointId",
        "applications"
      ]
    },
    "HydratedWorkspaceApplication": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "protocol": {
          "type": "string"
        },
        "releaseModuleId": {
          "type": "string"
        },
        "upstreamHost": {
          "type": [
            "string",
            "null"
          ]
        },
        "vmId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "vmId",
        "port",
        "protocol",
        "releaseModuleId"
      ]
    },
    "HydratedWorkspaceVm": {
      "type": "object",
      "properties": {
        "cpuMillis": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "diskMib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "memoryMib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "cpuMillis",
        "memoryMib",
        "diskMib"
      ]
    },
    "ImageArchitecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "ImageKey": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "scenario": {
          "type": "string"
        },
        "vm": {
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "vm",
        "arch"
      ]
    }
  }
}
