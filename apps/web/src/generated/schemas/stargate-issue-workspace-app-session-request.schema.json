{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssueWorkspaceAppSessionRequest",
  "type": "object",
  "properties": {
    "create_only": {
      "description": "Refuse to replace an existing route with this identifier.",
      "type": "boolean",
      "default": false
    },
    "metadata": {
      "$ref": "#/$defs/WorkspaceAppMetadata",
      "default": {}
    },
    "protocol": {
      "$ref": "#/$defs/WorkspaceAppProtocol"
    },
    "route_expires_at": {
      "type": "integer",
      "format": "int64"
    },
    "route_id": {
      "description": "Random, human-readable identifier generated by the control plane. It\nis a public route identity, not an authorization secret, and must not\ncontain user-provided labels or resource names.",
      "type": "string"
    },
    "target_app_port": {
      "description": "Allowlisted application port inside the guest. Stargate reaches it\nthrough an SSH direct-tcpip channel; it is never published on the host.",
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "target_host_key_openssh": {
      "type": "string"
    },
    "target_private_key_openssh": {
      "type": "string"
    },
    "target_username": {
      "type": "string"
    },
    "transport": {
      "description": "Literal IP and port of the guest SSH endpoint already exposed to\nStargate by the VM harness.",
      "$ref": "#/$defs/SshTargetTransport"
    },
    "upstream_host": {
      "description": "Optional virtual-host value sent only to the declared guest service.\nThe public route hostname remains available as X-Forwarded-Host.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "route_id",
    "target_username",
    "transport",
    "target_host_key_openssh",
    "target_private_key_openssh",
    "target_app_port",
    "protocol",
    "route_expires_at"
  ],
  "$defs": {
    "HostRelayIdentity": {
      "type": "object",
      "properties": {
        "credential_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "host_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_id",
        "session_id",
        "credential_generation"
      ]
    },
    "RelayService": {
      "type": "string",
      "enum": [
        "ssh"
      ]
    },
    "RelayTarget": {
      "type": "object",
      "properties": {
        "execution_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "execution_id": {
          "type": "string"
        },
        "host": {
          "$ref": "#/$defs/HostRelayIdentity"
        },
        "owner_id": {
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/RelayService"
        },
        "vm_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "owner_id",
        "execution_id",
        "execution_generation",
        "vm_id",
        "service"
      ]
    },
    "SshTargetTransport": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "direct"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "host",
            "port"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "relay"
            },
            "target": {
              "$ref": "#/$defs/RelayTarget"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        }
      ]
    },
    "WorkspaceAppMetadata": {
      "description": "Workspace app routes keep optional metadata: they carry no terminal route\nidentity, and an absent value is not an authorization decision.",
      "type": "object",
      "properties": {
        "host_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "vm_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "WorkspaceAppProtocol": {
      "type": "string",
      "enum": [
        "http"
      ]
    }
  }
}
