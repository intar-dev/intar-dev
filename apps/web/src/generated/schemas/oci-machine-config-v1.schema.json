{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MachineConfigV1",
  "description": "The config blob of a machine image. The image's identity is its\nmanifest's digest.",
  "type": "object",
  "properties": {
    "architecture": {
      "description": "The machines the image boots on. Every config says it; only one of\n[`PREVIOUS_IMAGE_FORMAT`], written before the field existed, does not.\nRead it through [`MachineConfigV1::architecture`].",
      "anyOf": [
        {
          "$ref": "#/$defs/Architecture"
        },
        {
          "type": "null"
        }
      ]
    },
    "boot": {
      "$ref": "#/$defs/MachineBootV1"
    },
    "build_key": {
      "$ref": "#/$defs/OciDigest"
    },
    "disk": {
      "$ref": "#/$defs/MachineDiskV1"
    },
    "guest_contract": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "image_format": {
      "type": "string"
    },
    "talos": {
      "description": "Set on the image of a Talos cluster node. Runtimes boot it without\nKino and give it no port forwards.",
      "anyOf": [
        {
          "$ref": "#/$defs/MachineTalosV1"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "guest_contract",
    "image_format",
    "build_key",
    "boot",
    "disk"
  ],
  "$defs": {
    "Architecture": {
      "description": "The processors machine images and Kino exist for.",
      "type": "string",
      "enum": [
        "amd64",
        "arm64"
      ]
    },
    "ClusterRole": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "controlplane",
            "worker"
          ]
        },
        {
          "description": "The cluster's trixie machine with kubectl, talosctl and their\nconfigs, where the learner works.",
          "type": "string",
          "const": "management"
        }
      ]
    },
    "MachineBootV1": {
      "type": "object",
      "properties": {
        "cmdline": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "cmdline"
      ]
    },
    "MachineDiskV1": {
      "type": "object",
      "properties": {
        "chunk_size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "chunks": {
          "description": "`[chunk_index, layer_index, raw_sha256]`; absent indexes are zero\nholes.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              },
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              {
                "$ref": "#/$defs/Sha256Hex"
              }
            ]
          }
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "size_bytes",
        "chunk_size",
        "chunks"
      ]
    },
    "MachineTalosV1": {
      "description": "A Talos node's place on its cluster's lab network.",
      "type": "object",
      "properties": {
        "lab_ip": {
          "description": "Its baked address on the lab network, e.g. `172.31.0.2`.",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ClusterRole"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "lab_ip"
      ]
    },
    "OciDigest": {
      "description": "An OCI digest of a blob or manifest: `sha256:` and 64 lowercase hex\ndigits.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Sha256Hex": {
      "description": "A SHA-256 as 64 lowercase hex digits. Hosts name files after these, so\nnothing else parses.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
