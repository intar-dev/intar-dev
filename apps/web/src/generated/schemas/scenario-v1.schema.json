{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioV1",
  "type": "object",
  "properties": {
    "briefing": {
      "type": "string"
    },
    "clusters": {
      "description": "Talos clusters; their machines are among `machines`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClusterV1"
      }
    },
    "credit": {
      "type": [
        "string",
        "null"
      ]
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "hints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HintV1"
      }
    },
    "machines": {
      "description": "File order is the terminal tab order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MachineV1"
      }
    },
    "minutes": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "play": {
      "type": "boolean"
    },
    "slug": {
      "type": "string"
    },
    "solution": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "description": "File order is the order learners see.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskV1"
      }
    },
    "title": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "summary",
    "difficulty",
    "minutes",
    "tags",
    "play",
    "briefing",
    "solution",
    "hints",
    "machines",
    "tasks"
  ],
  "$defs": {
    "ClusterRole": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "controlplane",
            "worker"
          ]
        },
        {
          "description": "The cluster's trixie machine with kubectl, talosctl and their\nconfigs, where the learner works.",
          "type": "string",
          "const": "management"
        }
      ]
    },
    "ClusterV1": {
      "description": "A Talos cluster: its nodes and its management machine are the machines\nwhose `cluster` names it.",
      "type": "object",
      "properties": {
        "kubernetes": {
          "description": "The Kubernetes release, e.g. `v1.37.1`.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "patches": {
          "description": "Talos machine-config patches (YAML), applied to every node in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScriptV1"
          }
        },
        "talos": {
          "description": "The Talos release, e.g. `v1.15.0-beta.0`; with `kubernetes` one of\n[`TALOS_RELEASES`].",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "talos",
        "kubernetes",
        "patches"
      ]
    },
    "Difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "HintV1": {
      "type": "object",
      "properties": {
        "body": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "body"
      ]
    },
    "MachineClusterV1": {
      "description": "A machine's place in a cluster.",
      "type": "object",
      "properties": {
        "cluster": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ClusterRole"
        }
      },
      "additionalProperties": false,
      "required": [
        "cluster",
        "role"
      ]
    },
    "MachineV1": {
      "type": "object",
      "properties": {
        "cluster": {
          "description": "Set on a machine of a Talos cluster.",
          "anyOf": [
            {
              "$ref": "#/$defs/MachineClusterV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_millis": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "defer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disk_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "egress": {
          "type": "boolean"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "from": {
          "description": "`trixie`, `talos` for a cluster node, or the name of an image.",
          "type": "string"
        },
        "memory_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "ready": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScriptV1"
          }
        },
        "setup": {
          "description": "Build-time stages in run order; `packages` is lowered to the first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScriptV1"
          }
        },
        "terminal": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "cpu_millis",
        "memory_mib",
        "disk_mib",
        "from",
        "defer",
        "terminal",
        "egress",
        "env",
        "setup",
        "ready"
      ]
    },
    "ProbeCheckV1": {
      "description": "A check Kino evaluates itself instead of running a script.",
      "type": "object",
      "properties": {
        "fail": {
          "description": "The learner message when it fails, instead of Kino's own.",
          "type": [
            "string",
            "null"
          ]
        },
        "probe": {
          "$ref": "#/$defs/ProbeV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "probe"
      ]
    },
    "ProbeV1": {
      "description": "A question to the machine's Kubernetes API, asked with the kubeconfig\nthat `KUBECONFIG` in the machine's env names (else `~/.kube/config`).",
      "oneOf": [
        {
          "description": "An object exists and, with `path`, a JSONPath in it matches exactly\none value, equal to `equals` when that is set: a string as it is,\nanything else as compact JSON.",
          "type": "object",
          "properties": {
            "equals": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "k8s"
            },
            "namespace": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "target": {
              "description": "`<resource>/<name>`, as kubectl takes it: `deployment/web`.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        },
        {
          "description": "A Deployment's current generation is observed and all its replicas\nare updated, Ready and available; `replicas` is the count it must want.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rollout"
            },
            "namespace": {
              "type": [
                "string",
                "null"
              ]
            },
            "replicas": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "target": {
              "description": "`deployment/<name>`.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        },
        {
          "description": "A SubjectAccessReview per verb: `user` with `groups` may (or, with\n`allowed` false, may not) do each verb on `resource`.",
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "can_i"
            },
            "namespace": {
              "type": [
                "string",
                "null"
              ]
            },
            "resource": {
              "description": "`<plural>[.<group>][/<subresource>]`: `pods`, `deployments.apps`.",
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "verbs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "verbs",
            "resource",
            "user",
            "groups",
            "allowed"
          ]
        }
      ]
    },
    "ScriptV1": {
      "description": "A named lowered bash script: a setup stage or a ready block.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "script": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "script"
      ]
    },
    "TaskV1": {
      "type": "object",
      "properties": {
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "check": {
          "description": "The task's script check bodies lowered into one script; blank when\nthe task has only probes.",
          "type": "string"
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HintV1"
          }
        },
        "id": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "needs": {
          "description": "Bare task IDs, on any machine.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "boolean"
        },
        "probes": {
          "description": "The checks Kino evaluates itself, in order, before `check`. Omitted\nwhen empty, so a scenario without them lowers as before.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProbeCheckV1"
          }
        },
        "solve": {
          "description": "Absent on an implied task: it must pass once its needs pass.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "machine",
        "needs",
        "optional",
        "check",
        "hints"
      ]
    }
  }
}
