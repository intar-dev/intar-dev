{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunCliProbeCheckResponseV1",
  "description": "One aggregate local Kino response. It contains no raw probe value,\ncommand, output, or error text; new fresh-check callers should use\n[`RunCliProbeCheckEventV1`] to stream real per-probe completions instead.",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunCliProbeCheckResultV1"
      },
      "maxItems": 128
    },
    "protocol_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 1,
      "minimum": 1
    },
    "request_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  },
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "checks"
  ],
  "$defs": {
    "RunCliCheckStatusV1": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "RunCliProbeCheckResultV1": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "probe_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "status": {
          "$ref": "#/$defs/RunCliCheckStatusV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "probe_id",
        "status",
        "duration_ms"
      ]
    }
  }
}
