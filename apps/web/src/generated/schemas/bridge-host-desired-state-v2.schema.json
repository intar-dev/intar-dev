{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostDesiredStateV2",
  "type": "object",
  "properties": {
    "builds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DesiredBuildV1"
      }
    },
    "cached_guest_tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DesiredGuestToolsV1"
      }
    },
    "cached_images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DesiredCachedImageV1"
      }
    },
    "generated_at_unix_ms": {
      "type": "integer",
      "format": "int64"
    },
    "host_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 4,
      "minimum": 4
    },
    "version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "vms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DesiredVmV2"
      }
    }
  },
  "required": [
    "schema_version",
    "host_id",
    "version",
    "generated_at_unix_ms",
    "cached_images",
    "vms",
    "builds"
  ],
  "$defs": {
    "DesiredBuildV1": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "build_id": {
          "type": "string"
        },
        "bundle_ref": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "rev": {
          "type": "string"
        },
        "scenario_id": {
          "type": "string"
        }
      },
      "required": [
        "build_id",
        "scenario_id",
        "arch",
        "rev",
        "content_hash",
        "bundle_ref"
      ]
    },
    "DesiredCachedImageV1": {
      "type": "object",
      "properties": {
        "image_id": {
          "type": "string"
        },
        "image_key": {
          "$ref": "#/$defs/ImageKey"
        }
      },
      "required": [
        "image_key",
        "image_id"
      ]
    },
    "DesiredGuestToolsV1": {
      "type": "object",
      "properties": {
        "bootstrap_abi": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "kino_sha256": {
          "type": "string"
        },
        "tools_disk_sha256": {
          "type": "string"
        },
        "tools_disk_size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "tools_disk_sha256",
        "tools_disk_size_bytes",
        "kino_sha256",
        "bootstrap_abi"
      ]
    },
    "DesiredVmPhase": {
      "type": "string",
      "enum": [
        "running",
        "absent"
      ]
    },
    "DesiredVmV2": {
      "type": "object",
      "properties": {
        "desired_phase": {
          "$ref": "#/$defs/DesiredVmPhase"
        },
        "guest_tools": {
          "$ref": "#/$defs/DesiredGuestToolsV1"
        },
        "image_id": {
          "type": "string"
        },
        "image_key": {
          "$ref": "#/$defs/ImageKey"
        },
        "lease_expires_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "resources": {
          "$ref": "#/$defs/VmResourcesV2"
        },
        "run_id": {
          "type": "string"
        },
        "ssh_authorized_keys_openssh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vm_name": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "vm_name",
        "desired_phase",
        "image_key",
        "image_id",
        "guest_tools",
        "resources",
        "ssh_authorized_keys_openssh",
        "lease_expires_at_unix_ms"
      ]
    },
    "ImageArchitecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "ImageKey": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "scenario": {
          "type": "string"
        },
        "vm": {
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "vm",
        "arch"
      ]
    },
    "VmResourcesV2": {
      "type": "object",
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "disk_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "memory_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "vcpu_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        }
      },
      "required": [
        "cpu_millis",
        "vcpu_count",
        "memory_mib",
        "disk_mib"
      ]
    }
  }
}
