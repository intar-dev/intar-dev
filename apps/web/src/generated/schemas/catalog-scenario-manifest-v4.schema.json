{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioManifestV4",
  "type": "object",
  "properties": {
    "briefing_markdown": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "difficulty": {
      "$ref": "#/$defs/ScenarioDifficulty"
    },
    "estimated_minutes": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "hints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioHintManifestV3"
      }
    },
    "name": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 4,
      "minimum": 4
    },
    "solution_markdown": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "vms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioVmManifestV4"
      }
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "name",
    "title",
    "category",
    "description",
    "difficulty",
    "estimated_minutes",
    "tags",
    "briefing_markdown",
    "solution_markdown",
    "hints",
    "vms"
  ],
  "$defs": {
    "ImageArchitecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "ImageFormat": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "raw_chunks_v1"
          ]
        },
        {
          "description": "Seven-day rollback compatibility. Scenario manifest v4 publication\nrejects this format; older retained catalog revisions may still carry\nit during the flag-day rollback window.",
          "type": "string",
          "const": "raw_zstd"
        }
      ]
    },
    "ImageKey": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "scenario": {
          "type": "string"
        },
        "vm": {
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "vm",
        "arch"
      ]
    },
    "ProbePhase": {
      "type": "string",
      "enum": [
        "boot",
        "scenario"
      ]
    },
    "ScenarioDifficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "ScenarioHintManifestV3": {
      "type": "object",
      "properties": {
        "body_markdown": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "body_markdown"
      ]
    },
    "ScenarioProbeManifestV3": {
      "type": "object",
      "properties": {
        "body_markdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioHintManifestV3"
          }
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/ProbePhase"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "phase",
        "kind",
        "display_name",
        "hints"
      ]
    },
    "ScenarioVmBootManifestV4": {
      "type": "object",
      "properties": {
        "cmdline": {
          "type": "string"
        },
        "initrd_sha256": {
          "type": "string"
        },
        "kernel_sha256": {
          "type": "string"
        }
      },
      "required": [
        "kernel_sha256",
        "initrd_sha256",
        "cmdline"
      ]
    },
    "ScenarioVmManifestV4": {
      "type": "object",
      "properties": {
        "boot": {
          "$ref": "#/$defs/ScenarioVmBootManifestV4"
        },
        "chunk_manifest_sha256": {
          "type": "string"
        },
        "cpu_millis": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "disk_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "guest_bootstrap_abi": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "image_format": {
          "$ref": "#/$defs/ImageFormat"
        },
        "image_id": {
          "type": "string"
        },
        "image_key": {
          "$ref": "#/$defs/ImageKey"
        },
        "image_virtual_size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "memory_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioProbeManifestV3"
          }
        },
        "vcpu_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        }
      },
      "required": [
        "name",
        "image_key",
        "image_id",
        "image_format",
        "image_virtual_size_bytes",
        "chunk_manifest_sha256",
        "guest_bootstrap_abi",
        "boot",
        "cpu_millis",
        "vcpu_count",
        "memory_mib",
        "disk_mib",
        "probes"
      ]
    }
  }
}
