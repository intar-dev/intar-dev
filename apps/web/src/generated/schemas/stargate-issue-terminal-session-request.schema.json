{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssueTerminalSessionRequest",
  "type": "object",
  "properties": {
    "generation": {
      "description": "Opaque route generation. An attach call must repeat this exact string.",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/RouteMetadata"
    },
    "mode": {
      "$ref": "#/$defs/TerminalSessionMode"
    },
    "route_expires_at": {
      "type": "integer",
      "format": "int64"
    },
    "route_username": {
      "type": "string"
    },
    "target": {
      "description": "`pending` for a browser route. `ready` with the complete endpoint for a\nnative route.",
      "$ref": "#/$defs/TerminalTargetState"
    }
  },
  "required": [
    "route_username",
    "generation",
    "target",
    "route_expires_at",
    "mode",
    "metadata"
  ],
  "$defs": {
    "RouteMetadata": {
      "description": "Route identity. Every field is mandatory and non-empty: a pending route\nmust name the host, the run, the VM, and the user that it belongs to.",
      "type": "object",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "vm_id": {
          "type": "string"
        }
      },
      "required": [
        "host_id",
        "run_id",
        "vm_id",
        "user_id"
      ]
    },
    "TerminalSessionMode": {
      "type": "string",
      "enum": [
        "browser",
        "native"
      ]
    },
    "TerminalTarget": {
      "description": "The complete SSH endpoint of one scenario VM terminal. Only the admin API\ncarries this value: `private_key_openssh` is the credential that reaches\nthe guest, and the gateway never sends it to a browser or a native client.",
      "type": "object",
      "properties": {
        "authorized_client_public_keys_openssh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "type": "string"
        },
        "host_key_openssh": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "private_key_openssh": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "username",
        "host",
        "port",
        "host_key_openssh",
        "private_key_openssh",
        "authorized_client_public_keys_openssh"
      ]
    },
    "TerminalTargetState": {
      "description": "One terminal route. A browser route starts pending: the route exists and a\nbrowser socket can connect, but Stargate must not dial the guest yet. An\nadmin attach moves the route to ready, and only then does the PTY and the\nrecording start.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "pending"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "ready"
            }
          },
          "$ref": "#/$defs/TerminalTarget",
          "required": [
            "state"
          ]
        }
      ]
    }
  }
}
