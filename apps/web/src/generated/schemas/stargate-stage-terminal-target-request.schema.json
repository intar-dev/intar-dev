{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageTerminalTargetRequest",
  "description": "Stage a ready target on a pending browser route. The gateway stores the\ntarget and returns an attachment identifier, but the route is still not\nready: no waiter wakes and no socket dials. The control plane activates the\nattachment after its own admission fence.",
  "type": "object",
  "properties": {
    "generation": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "target": {
      "description": "The complete target. There is no pending shape on a stage call: a call\nthat carries no target is a validation error.",
      "$ref": "#/$defs/TerminalTarget"
    },
    "user_id": {
      "type": "string"
    },
    "vm_id": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "vm_id",
    "user_id",
    "generation",
    "target"
  ],
  "$defs": {
    "HostRelayIdentity": {
      "type": "object",
      "properties": {
        "credential_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "host_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_id",
        "session_id",
        "credential_generation"
      ]
    },
    "RelayService": {
      "type": "string",
      "enum": [
        "ssh"
      ]
    },
    "RelayTarget": {
      "type": "object",
      "properties": {
        "execution_generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "execution_id": {
          "type": "string"
        },
        "host": {
          "$ref": "#/$defs/HostRelayIdentity"
        },
        "owner_id": {
          "type": "string"
        },
        "service": {
          "$ref": "#/$defs/RelayService"
        },
        "vm_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "owner_id",
        "execution_id",
        "execution_generation",
        "vm_id",
        "service"
      ]
    },
    "SshTargetTransport": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "direct"
            },
            "port": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "host",
            "port"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "relay"
            },
            "target": {
              "$ref": "#/$defs/RelayTarget"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ]
        }
      ]
    },
    "TerminalTarget": {
      "description": "The complete SSH endpoint of one scenario VM terminal. Only the admin API\ncarries this value: `private_key_openssh` is the credential that reaches\nthe guest, and the gateway never sends it to a browser or a native client.",
      "type": "object",
      "properties": {
        "authorized_client_public_keys_openssh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host_key_openssh": {
          "type": "string"
        },
        "private_key_openssh": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/SshTargetTransport"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "username",
        "transport",
        "host_key_openssh",
        "private_key_openssh",
        "authorized_client_public_keys_openssh"
      ]
    }
  }
}
