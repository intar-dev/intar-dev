{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesiredSourceCompileV1",
  "description": "One repository snapshot a builder compiles, fetched by `compile_id` and\n`attempt`. It carries no secret and no scope: the Worker takes both from\nthe compile row.",
  "type": "object",
  "properties": {
    "arch": {
      "$ref": "#/$defs/ImageArchitecture"
    },
    "attempt": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "compile_id": {
      "type": "string"
    },
    "rev": {
      "type": "string"
    },
    "validate_only": {
      "type": "boolean"
    }
  },
  "required": [
    "compile_id",
    "attempt",
    "rev",
    "validate_only",
    "arch"
  ],
  "$defs": {
    "ImageArchitecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    }
  }
}
