{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VmReportV2",
  "type": "object",
  "properties": {
    "archive": {
      "anyOf": [
        {
          "$ref": "#/$defs/VmArchiveStateV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "desired_version": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "host_id": {
      "type": "string"
    },
    "network": {
      "anyOf": [
        {
          "$ref": "#/$defs/VmNetworkStateV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at_unix_ms": {
      "type": "integer",
      "format": "int64"
    },
    "phase": {
      "$ref": "#/$defs/VmPhase"
    },
    "probes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VmProbeSnapshotV1"
      }
    },
    "resource_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/VmResourceStateV2"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string"
    },
    "runtime_constraints": {
      "anyOf": [
        {
          "$ref": "#/$defs/VmRuntimeConstraintsV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "sandbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/VmSandboxStateV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 3,
      "minimum": 3
    },
    "ssh_host_keys_openssh": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "terminal": {
      "$ref": "#/$defs/VmTerminalStateV1"
    },
    "vm_name": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "host_id",
    "run_id",
    "vm_name",
    "observed_at_unix_ms",
    "phase",
    "terminal",
    "ssh_host_keys_openssh",
    "probes"
  ],
  "$defs": {
    "ProbePhase": {
      "type": "string",
      "enum": [
        "boot",
        "scenario"
      ]
    },
    "VmArchivePhase": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "uploading",
        "complete",
        "failed"
      ]
    },
    "VmArchiveStateV1": {
      "type": "object",
      "properties": {
        "artifact_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/VmArchivePhase"
        }
      },
      "required": [
        "phase",
        "artifact_count"
      ]
    },
    "VmNetworkStateV1": {
      "type": "object",
      "properties": {
        "bridge_name": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "guest_cidr": {
          "type": "string"
        },
        "guest_ip": {
          "type": "string"
        },
        "ssh_host": {
          "description": "Publicly routable address of the agent host's SSH forward for this VM\n(the agent's advertised host). The guest IP is only reachable within\nthe agent's internal VM network.",
          "type": [
            "string",
            "null"
          ]
        },
        "ssh_host_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "bridge_name",
        "guest_ip",
        "guest_cidr",
        "gateway"
      ]
    },
    "VmPhase": {
      "type": "string",
      "enum": [
        "pending",
        "pulling_image",
        "creating_disks",
        "booting",
        "running",
        "ready",
        "solved",
        "stopping",
        "stopped",
        "failed",
        "absent"
      ]
    },
    "VmProbeSnapshotV1": {
      "type": "object",
      "properties": {
        "checked_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/ProbePhase"
        },
        "status": {
          "$ref": "#/$defs/VmProbeStatus"
        },
        "value": true
      },
      "required": [
        "id",
        "phase",
        "status",
        "checked_at_unix_ms"
      ]
    },
    "VmProbeStatus": {
      "type": "string",
      "enum": [
        "unknown",
        "pass",
        "fail"
      ]
    },
    "VmResourceStateV2": {
      "type": "object",
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "cpu_nr_periods": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cpu_nr_throttled": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cpu_period_us": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "cpu_quota_us": {
          "type": "integer",
          "format": "uint64",
          "minimum": 1
        },
        "cpu_system_usec": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cpu_throttled_usec": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cpu_usage_usec": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cpu_user_usec": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "vcpu_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        }
      },
      "required": [
        "cpu_millis",
        "vcpu_count",
        "cpu_quota_us",
        "cpu_period_us",
        "cpu_usage_usec",
        "cpu_user_usec",
        "cpu_system_usec",
        "cpu_nr_periods",
        "cpu_nr_throttled",
        "cpu_throttled_usec"
      ]
    },
    "VmRuntimeConstraintPhaseV1": {
      "type": "string",
      "enum": [
        "boot_burst",
        "steady"
      ]
    },
    "VmRuntimeConstraintsV1": {
      "type": "object",
      "properties": {
        "effective_cpu_millis": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        },
        "generation": {
          "description": "Jailer-owned generation to which every quota and ingress attestation\nin this object applies. The breaking v2 contract never accepts\ngeneration-less quota evidence.",
          "type": "string"
        },
        "lease_expires_at_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "phase": {
          "$ref": "#/$defs/VmRuntimeConstraintPhaseV1"
        },
        "quota_verified_at_unix_ms": {
          "description": "Timestamp of the authoritative live cgroup readback. Required by the\ncontrol plane before a `steady` runtime can expose a terminal.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "steady_cpu_millis": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        }
      },
      "required": [
        "generation",
        "phase",
        "steady_cpu_millis",
        "effective_cpu_millis"
      ]
    },
    "VmSandboxStateV1": {
      "type": "object",
      "properties": {
        "cgroup_path": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "healthy": {
          "type": "boolean"
        },
        "landlock_enabled": {
          "type": "boolean"
        },
        "no_new_privs": {
          "type": "boolean"
        },
        "seccomp_enabled": {
          "type": "boolean"
        },
        "systemd_unit": {
          "type": "string"
        }
      },
      "required": [
        "healthy",
        "generation",
        "systemd_unit",
        "cgroup_path",
        "seccomp_enabled",
        "landlock_enabled",
        "no_new_privs"
      ]
    },
    "VmTerminalStateKindV1": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed"
      ]
    },
    "VmTerminalStateV1": {
      "type": "object",
      "properties": {
        "observed_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/VmTerminalStateKindV1"
        },
        "target": {
          "description": "Present only when `state` is `ready`.",
          "anyOf": [
            {
              "$ref": "#/$defs/VmTerminalTargetV1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "observed_at_unix_ms"
      ]
    },
    "VmTerminalTargetV1": {
      "type": "object",
      "properties": {
        "checked_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "port",
        "username",
        "checked_at_unix_ms"
      ]
    }
  }
}
