{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KinoConfigV1",
  "description": "The config blob of a Kino manifest.",
  "type": "object",
  "properties": {
    "architecture": {
      "description": "The guests the binary runs in. An artifact made before the field\nexisted names none and is amd64.",
      "anyOf": [
        {
          "$ref": "#/$defs/Architecture"
        },
        {
          "type": "null"
        }
      ]
    },
    "guest_contract": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "guest_contract",
    "version"
  ],
  "$defs": {
    "Architecture": {
      "description": "The processors machine images and Kino exist for.",
      "type": "string",
      "enum": [
        "amd64",
        "arm64"
      ]
    }
  }
}
