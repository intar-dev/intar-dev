---
import "../styles/global.css";
import { JoinBeta } from "../components/app/pages/JoinBeta";
import {
  JOIN_LOCAL_DEVELOPMENT_META_CONTENT_SECURITY_POLICY,
  JOIN_META_CONTENT_SECURITY_POLICY,
} from "../lib/join-security";

const JOIN_THEME_BOOTSTRAP_SCRIPT = `(()=>{let t="system";try{const s=localStorage.getItem("intar-theme");if(s==="light"||s==="dark"||s==="system")t=s}catch{}const d=t==="dark"||(t==="system"&&matchMedia("(prefers-color-scheme: dark)").matches);document.documentElement.dataset.theme=t;document.documentElement.classList.toggle("dark",d)})();`;
const joinContentSecurityPolicy = import.meta.env.DEV
	? JOIN_LOCAL_DEVELOPMENT_META_CONTENT_SECURITY_POLICY
	: JOIN_META_CONTENT_SECURITY_POLICY;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			http-equiv="Content-Security-Policy"
			content={joinContentSecurityPolicy}
		/>
		<meta http-equiv="Cache-Control" content="no-store, max-age=0" />
		<meta http-equiv="Pragma" content="no-cache" />
		<meta http-equiv="Expires" content="0" />
		<meta name="referrer" content="no-referrer" />
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta
			name="description"
			content="Claim a private intar.dev beta invitation with GitHub."
		/>
		<title>Claim beta access · intar.dev</title>
		<script is:inline>(()=>{const p=new URLSearchParams(location.hash.slice(1));const i=p.get("invite");history.replaceState(history.state,"",location.pathname+location.search);Object.defineProperty(window,"__INTAR_BETA_INVITE__",{value:i,configurable:true});})();</script>
		<script is:inline set:html={JOIN_THEME_BOOTSTRAP_SCRIPT}></script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body class="min-h-screen">
		<JoinBeta client:load />
	</body>
</html>
