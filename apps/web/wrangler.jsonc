{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "intar-dev",
  "main": "src/worker.ts",
  "secrets": {
    "required": [
      "CONTROL_PLANE_MAINTENANCE_BYPASS_SECRET",
      "STARGATE_EGRESS_IPV4_CIDRS",
      "GITHUB_APP_PRIVATE_KEY",
      "GITHUB_APP_WEBHOOK_SECRET",
    ],
  },
  "vars": {
    "BETTER_AUTH_APP_NAME": "intar.dev",
    "BETTER_AUTH_URL": "https://intar.dev",
    // Planned control-plane maintenance generates a temporary maintenance-on
    // version; committed steady state is open.
    "CONTROL_PLANE_MAINTENANCE": "off",
    // Keep host capability selection open while CLI-ready images and agents
    // roll out. Set this to "on" only in the final rollout deployment.
    "LEARNER_RUN_CLI_V1_ENFORCEMENT": "off",
    "AGENT_JWT_ISSUER": "intar-agent-bridge",
    "AGENT_JWT_AUDIENCE": "agent-connect",
    "STARGATE_ROUTE_TTL_SECONDS": "14400",
    "STARGATE_ADMIN_AUTH_HEADER": "cf-access-jwt-assertion",
    "STARGATE_ADMIN_AUTH_ISSUER": "intar.dev",
    "STARGATE_ADMIN_AUTH_AUDIENCE": "stargate-admin",
    // The GitHub App client fails closed while this or the
    // GITHUB_APP_PRIVATE_KEY secret is empty.
    "GITHUB_APP_CLIENT_ID": "Iv23lifjtuTYzowesJsG",
    // sha256 of the released base-images.hcl. It feeds the platform compile
    // digest; while it is empty no builder takes a `git-` image build.
    "PLATFORM_BASE_IMAGES_SHA256": "f23d63aa99d7dc99b4acd7d6063e0b606a4d94c778b433cd3ecf5d46184162c6",
    // The App's URL name, for the scenario source card's install link.
    "GITHUB_APP_SLUG": "intar-dev-image-builder",
    // The only GitHub repository id the public scope may bind. Empty: none.
    "PUBLIC_SCENARIO_SOURCE_REPOSITORY_ID": "1305773952",
    // Peeled commit SHAs of the released scenario-publish-vN tags, separated
    // by commas or whitespace. Empty: every push upload is refused.
    "SCENARIO_PUBLISH_WORKFLOW_SHAS": "a73e571caccc35b499fa11e021f4ac6a9546b647",
    // The intar-image-cli release the compiler descriptor names, and its
    // release tarball sha256 per target as JSON, e.g. {"linux_amd64":"<hex>"}.
    // While either is empty the descriptor answers 503.
    "SCENARIO_COMPILER_CLI_VERSION": "0.10.0",
    // Public run shares keep their terminal logs next to the run recordings.
    // Local workerd has no jurisdictions, so local configs leave this unset.
    "RUN_SHARE_JURISDICTION": "eu",
    // The public origin of SHARE_LIVE_BUCKET, and its zone for cache purges
    // (with the optional SHARE_LIVE_PURGE_TOKEN secret).
    "SHARE_LIVE_ORIGIN": "https://live.intar.dev",
    "SCENARIO_COMPILER_CLI_SHA256": "{\"linux_amd64\":\"de9ae8ddcb4264a04e6529b194d6a4ad6368bbc79ba229411417e947f67f6bd5\",\"linux_arm64\":\"58007336f801cb0ff886584497dffc70840037081a5362ffd80a84b3498b3c2c\"}",
  },
  "vpc_services": [
    {
      "binding": "STARGATE_ADMIN_SERVICE",
      "service_id": "019cfe24-0643-7f91-baa3-cd890fdb8af4",
    },
  ],
  "services": [
    {
      // The image registry cleanup worker has no public route, so this binding
      // is the only path to its RPC surface.
      "binding": "REGISTRY_CLEANUP",
      "service": "intar-dev-image-registry-cleanup",
      "entrypoint": "RegistryCleanup",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    {
      "pattern": "intar.dev",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      // D1 has no supported database-name mutation; the UUID is the stable
      // production identity and must remain paired with its actual name.
      "database_id": "c53ff120-c555-4702-b3a1-eaab44fd76f6",
      "database_name": "intar-dev-control-plane-v3-20260813-r2",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "VM_IMAGE_REGISTRY_BUCKET",
      "bucket_name": "intar-dev-vm-image-registry-20260709",
      "jurisdiction": "eu",
    },
    {
      // Public run shares, served to viewers from the CDN by a custom domain
      // (SHARE_LIVE_ORIGIN). Holds only what owners chose to share.
      "binding": "SHARE_LIVE_BUCKET",
      "bucket_name": "intar-dev-share-live-20261005",
      "jurisdiction": "eu",
    },
    {
      "binding": "VM_RUN_ARTIFACTS_BUCKET",
      "bucket_name": "intar-dev-vm-run-artifacts-20260709",
      "jurisdiction": "eu",
    },
  ],
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "12f35c20-55f4-47ee-8b31-b3ad202d1f04",
      "remote": true,
    },
  ],
  "ratelimits": [
    {
      "name": "ACCESS_INVITE_RATE_LIMITER",
      "namespace_id": "88427091",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOST_RUNTIME",
        "class_name": "HostRuntimeDO",
      },
      {
        // One per scenario source binding, named by its scope key.
        "name": "SCENARIO_SOURCE",
        "class_name": "ScenarioSourceDO",
      },
      {
        // One per public run share, named by its share id in the EU
        // jurisdiction: the share's terminal log, written once, read by
        // every viewer.
        "name": "RUN_SHARE",
        "class_name": "RunShareDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentBridgeDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ScenarioWorkflowDO",
        "ScenarioWorkflowSchedulerDO",
      ],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["HostRuntimeDO"],
    },
    {
      "tag": "v4",
      "deleted_classes": [
        "AgentBridgeDO",
        "ScenarioWorkflowDO",
        "ScenarioWorkflowSchedulerDO",
      ],
    },
    {
      // A revert that stops exporting ScenarioSourceDO must add a
      // `deleted_classes: ["ScenarioSourceDO"]` migration in the same deploy.
      "tag": "v5",
      "new_sqlite_classes": ["ScenarioSourceDO"],
    },
    {
      // A revert that stops exporting RunShareDO must add a
      // `deleted_classes: ["RunShareDO"]` migration in the same deploy.
      "tag": "v6",
      "new_sqlite_classes": ["RunShareDO"],
    },
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "persist": false,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "destinations": ["intar-grafana-logs"],
    },
    "traces": {
      "enabled": true,
      "persist": false,
      "head_sampling_rate": 1,
      "destinations": ["intar-grafana-traces"],
    },
  },
}
