{
  "version": 1,
  "zone": {
    "name": "intar.app",
    "preserveExactNames": [
      "admin.intar.app",
      "ssh.intar.app",
      "ws.intar.app"
    ],
    "wildcardRecord": {
      "type": "CNAME",
      "name": "*.intar.app",
      "content": "8cdc5d07-3703-4508-9dc6-3dc861dd560b.cfargotunnel.com",
      "proxied": true,
      "ttl": 1,
      "comment": "Managed by intar-dev workshop app edge workflow"
    }
  },
  "tunnel": {
    "id": "8cdc5d07-3703-4508-9dc6-3dc861dd560b",
    "baselineIngress": [
      {
        "hostname": "ws.intar.app",
        "service": "http://127.0.0.1:8080"
      },
      {
        "service": "http_status:404"
      }
    ],
    "desiredIngress": [
      {
        "hostname": "ws.intar.app",
        "service": "http://127.0.0.1:8080"
      },
      {
        "hostname": "*.intar.app",
        "service": "http://127.0.0.1:8080"
      },
      {
        "service": "http_status:404"
      }
    ]
  },
  "cacheRule": {
    "phase": "http_request_cache_settings",
    "rulesetName": "Intar cache settings",
    "rulesetDescription": "Zone cache settings managed through reviewed automation",
    "ref": "intar_workshop_app_hosts_bypass_cache_v1",
    "description": "Intar workshop application hosts must never be cached",
    "expression": "(http.host wildcard \"wa-*.intar.app\")",
    "action": "set_cache_settings",
    "action_parameters": {
      "cache": false
    },
    "enabled": true
  }
}
