[Unit]
Description=Intar Cloud Hypervisor jail supervisor
Requires=intar-vms.slice
After=systemd-udevd.service
RequiresMountsFor=/var/lib/intar/jails /var/cache/intar-agent /run/netns

[Service]
Type=simple
ExecStart=/usr/lib/intar/intar-jailerd run --config /etc/intar-jailerd/config.toml
User=root
Group=root
Restart=on-failure
RestartSec=2
NoNewPrivileges=false
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Named netns handles are created in PID 1's mount namespace and accessed
# read-only through /proc/1/root; the daemon never needs a writable local view.
ReadWritePaths=/var/lib/intar/jails /var/cache/intar-agent /run/intar-jailerd
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
# The daemon writes net.ipv4.ip_forward only after setns into a freshly
# created run namespace. ProtectKernelTunables would make that namespaced
# procfs setting read-only; host-wide forwarding is an installer prerequisite.
ProtectKernelTunables=false
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# systemd 255 implements RestrictSUIDSGID by making openat2 return ENOSYS.
# Jailerd requires openat2 for every trusted-root lookup, so keep this disabled;
# its typed protocol and exclusive, verified file creation never request SUID or
# SGID bits.
RestrictSUIDSGID=false
RestrictRealtime=true
LimitRTPRIO=0
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/net/tun rw
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/null rw
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_MKNOD CAP_NET_ADMIN CAP_SETGID CAP_SETPCAP CAP_SETUID CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SYS_PTRACE CAP_SYS_RESOURCE
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount @privileged

[Install]
WantedBy=multi-user.target
