[Unit]
Description=Intar jailer control socket
# The default Before=sockets.target would order this socket ahead of
# basic.target, while intar-jailerd-boot-check.service, an ordinary service
# after basic.target, must finish first: an ordering cycle. These are the
# remaining default dependencies of a socket unit.
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target systemd-tmpfiles-setup.service
Before=shutdown.target
Conflicts=shutdown.target

[Socket]
ListenSequentialPacket=/run/intar-jailerd/control.sock
Service=intar-jailerd.service
SocketMode=0660
SocketUser=root
SocketGroup=intar-agent
FileDescriptorName=control
Backlog=64
FlushPending=true
RemoveOnStop=true
TriggerLimitIntervalSec=30s
TriggerLimitBurst=10

[Install]
WantedBy=sockets.target
