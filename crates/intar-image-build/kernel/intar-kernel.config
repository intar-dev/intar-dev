# Intar cutover kernel profile. There is one profile. There is no variant,
# toggle, or fallback.
#
# The build applies these lines to "make x86_64_defconfig" with
# scripts/config, resolves them with "make olddefconfig", and then verifies
# every symbol in KERNEL_REQUIRED_BUILTINS in src/kernel.rs against the final
# .config. A missing symbol fails the build. Do not remove a "=y" line without
# changing that list in the same commit.
#
# CONFIG_MODULES stays on so that modprobe reports success for a built-in name:
# systemd-modules-load reads /etc/modules-load.d/90-intar-runtime.conf at boot
# and must not fail. Every required feature below is built in, and the build
# fails when one of them is not. The build also fails when Kconfig resolves any
# symbol to "=m", because it produces bzImage only: a module would not exist in
# the guest. The final profile is therefore provably free of loadable modules,
# and the only thing that reaches the module tree is the built-in index.

# --- identity --------------------------------------------------------------
CONFIG_LOCALVERSION="-intar-cutover"

# --- boot path -------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PNP=y
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_INPUT=y

# --- virtio and vsock ------------------------------------------------------
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# --- filesystems -----------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_TMPFS_POSIX_ACL=y

# --- cgroup v2, namespaces, LSM -------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="lockdown,yama,apparmor"

# --- BPF -------------------------------------------------------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y

# --- networking, netfilter, overlay and Kubernetes data paths -------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VXLAN=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_LOG_ARP=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y

# --- loadable module plumbing (no loadable modules exist) -----------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- size and boot-time reductions ----------------------------------------
# The guest is serial only. These are preferences, not contract lines, so a
# selector in the tree may turn one of them back on without failing the build.
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_KALLSYMS=n
CONFIG_KALLSYMS_ALL=n
CONFIG_DEBUG_KERNEL=n
CONFIG_FRAME_POINTER=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_AGP=n
CONFIG_SOUND=n
CONFIG_VT=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_HID=n
CONFIG_USB_SUPPORT=n
CONFIG_SCSI=n
CONFIG_ISDN=n
CONFIG_FDDI=n
CONFIG_HAMRADIO=n
CONFIG_XFRM_USER=n
CONFIG_NFS_FS=n
CONFIG_9P_FS=n
CONFIG_CEPH_FS=n
CONFIG_FUSE_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_X86_PKG_TEMP_THERMAL=n
CONFIG_EFIVAR_FS=n
