[Unit]
Description=intar-agent
After=network-online.target intar-jailerd.socket
Wants=network-online.target intar-jailerd.socket

[Service]
Type=simple
User=intar-agent
Group=intar-agent
ExecStart=/usr/local/bin/intar-agent --config /etc/intar-agent/config.toml
KillMode=control-group
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
Environment=XDG_CACHE_HOME=/var/cache/intar-agent
Environment=XDG_STATE_HOME=/var/cache/intar-agent/state
CapabilityBoundingSet=
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LimitRTPRIO=0
SystemCallArchitectures=native
ReadOnlyPaths=/run/intar-jailerd
ReadWritePaths=/var/cache/intar-agent

[Install]
WantedBy=multi-user.target
