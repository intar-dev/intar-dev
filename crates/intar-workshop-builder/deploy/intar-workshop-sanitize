#!/usr/bin/env bash
set -euo pipefail

# Fixed guest-side sanitizer installed in the dedicated workshop base image.
# The host removes configured canonical build-material paths before invoking
# this program. Manual verifiers and /etc/kino/kino.hcl.tpl intentionally stay.
test -x /usr/local/lib/intar-workshop/run-probe
test -s /etc/kino/kino.hcl.tpl
test -d /usr/local/lib/intar-workshop/verifiers

rm -f -- /root/.bash_history /home/ubuntu/.bash_history
rm -f -- /root/.ssh/authorized_keys /home/ubuntu/.ssh/authorized_keys
rm -f -- /etc/ssh/ssh_host_*
rm -f -- /etc/udev/rules.d/70-persistent-net.rules
rm -f -- /var/lib/dbus/machine-id
rm -rf -- /var/lib/cloud/instances
find /tmp /var/tmp -mindepth 1 -maxdepth 1 -xdev -exec rm -rf -- {} +
journalctl --rotate >/dev/null 2>&1 || true
journalctl --vacuum-time=1s >/dev/null 2>&1 || true
find /var/log -xdev -type f -exec truncate -s 0 -- {} +
truncate -s 0 /etc/machine-id
sync
