[Unit]
Description=Intar Workshop learner workspace agent
Wants=network-online.target kino.service
After=network-online.target kino.service
ConditionPathExists=/etc/intar/workspace-agent.toml
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
UMask=0077
Environment=RUST_LOG=intar_workspace_agent=info
ExecStart=/usr/local/sbin/intar-workspace-agent --config /etc/intar/workspace-agent.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
