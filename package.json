{
  "name": "@intar/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.17.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  },
  "scripts": {
    "check:imports": "bun tools/check-import-boundaries.ts",
    "check:deploy": "vitest run tools/deploy",
    "check:vm-boot-benchmark": "python3 -m unittest discover -s tools -p 'test_*.py' && bun test tools/vm-boot-benchmark",
    "check:database-migrations": "bun run --cwd apps/web db:check && bun test tools/database",
    "clean:generated": "bun tools/cleanup-generated.ts",
    "test:web": "bun run --cwd apps/web test",
    "build:web": "bun run --cwd apps/web build",
    "check": "bun run check:imports && bun run check:deploy && bun run check:vm-boot-benchmark && bun run check:database-migrations && bun run --cwd apps/web db:schema:check",
    "test": "bun run check && bun run test:web",
    "build": "bun run build:web"
  },
  "overrides": {
    "@better-auth/core": "1.7.6",
    "@cloudflare/vite-plugin": "1.62.0",
    "@hono/node-server": "1.19.17",
    "ajv": "8.20.0",
    "astro": "7.3.5",
    "defu": "6.1.7",
    "devalue": "5.9.4",
    "effect": "3.22.2",
    "esbuild": "0.25.12",
    "fast-uri": "3.1.8",
    "hono": "4.13.11",
    "js-yaml": "4.3.2",
    "kysely": "0.28.17",
    "lodash": "4.18.1",
    "nanoid": "3.3.19",
    "picomatch": "2.3.2",
    "rollup": "4.63.5",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "svgo": "4.1.0",
    "undici": "7.30.0",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "patchedDependencies": {
    "@better-auth/sso@1.7.6": "patches/@better-auth%2Fsso@1.7.6.patch",
    "@better-auth/core@1.7.6": "patches/@better-auth%2Fcore@1.7.6.patch"
  }
}
