{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssueWorkspaceAppSessionRequest",
  "type": "object",
  "properties": {
    "metadata": {
      "$ref": "#/$defs/RouteMetadata",
      "default": {
        "host_id": null,
        "run_id": null,
        "user_id": null,
        "vm_id": null
      }
    },
    "protocol": {
      "$ref": "#/$defs/WorkspaceAppProtocol"
    },
    "route_expires_at": {
      "type": "integer",
      "format": "int64"
    },
    "route_id": {
      "description": "Opaque, unguessable identifier generated by the control plane. It is\nused as the public route identity and must not contain user-provided\nlabels or resource names.",
      "type": "string"
    },
    "target_app_port": {
      "description": "Allowlisted application port inside the guest. Stargate reaches it\nthrough an SSH direct-tcpip channel; it is never published on the host.",
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "target_host_key_openssh": {
      "type": "string"
    },
    "target_ip": {
      "description": "Literal IP and port of the guest SSH endpoint already exposed to\nStargate by the VM harness.",
      "type": "string"
    },
    "target_private_key_openssh": {
      "type": "string"
    },
    "target_ssh_port": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "target_username": {
      "type": "string"
    }
  },
  "required": [
    "route_id",
    "target_username",
    "target_ip",
    "target_ssh_port",
    "target_host_key_openssh",
    "target_private_key_openssh",
    "target_app_port",
    "protocol",
    "route_expires_at"
  ],
  "$defs": {
    "RouteMetadata": {
      "type": "object",
      "properties": {
        "host_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "vm_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "WorkspaceAppProtocol": {
      "type": "string",
      "enum": [
        "http"
      ]
    }
  }
}
