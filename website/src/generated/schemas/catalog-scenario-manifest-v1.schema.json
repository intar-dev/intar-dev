{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioManifestV1",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "vms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScenarioVmManifestV1"
      }
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "name",
    "description",
    "vms"
  ],
  "$defs": {
    "ImageArchitecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "ImageKey": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "scenario": {
          "type": "string"
        },
        "vm": {
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "vm",
        "arch"
      ]
    },
    "ProbePhase": {
      "type": "string",
      "enum": [
        "boot",
        "scenario"
      ]
    },
    "ScenarioProbeManifestV1": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/ProbePhase"
        }
      },
      "required": [
        "id",
        "phase",
        "kind",
        "display_name"
      ]
    },
    "ScenarioVmManifestV1": {
      "type": "object",
      "properties": {
        "cpu_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "disk_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "image_key": {
          "$ref": "#/$defs/ImageKey"
        },
        "image_sha256": {
          "type": "string"
        },
        "memory_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioProbeManifestV1"
          }
        }
      },
      "required": [
        "name",
        "image_key",
        "image_sha256",
        "cpu_count",
        "memory_mib",
        "disk_mib",
        "probes"
      ]
    }
  }
}
