{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BridgeMessageV5",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "client_hello"
        }
      },
      "$ref": "#/$defs/ClientHelloV5",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "server_hello"
        }
      },
      "$ref": "#/$defs/ServerHelloV5",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "desired_state"
        }
      },
      "$ref": "#/$defs/DesiredStateV5",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "state_report"
        }
      },
      "$ref": "#/$defs/StateReportV5",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "vm_report"
        }
      },
      "$ref": "#/$defs/VmReportV5",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "build_report"
        }
      },
      "$ref": "#/$defs/BuildReportV5",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sync_request"
        }
      },
      "$ref": "#/$defs/SyncRequestV5",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "BuildPhase": {
      "type": "string",
      "enum": [
        "queued",
        "fetching_sources",
        "building_base",
        "building",
        "publishing",
        "uploading_logs",
        "succeeded",
        "failed"
      ]
    },
    "BuildReportV1": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "build_id": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "current_vm": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "host_id": {
          "type": "string"
        },
        "observed_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "phase": {
          "$ref": "#/$defs/BuildPhase"
        },
        "scenario_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "started_at_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "schema_version",
        "host_id",
        "build_id",
        "scenario_id",
        "content_hash",
        "observed_at_unix_ms",
        "phase",
        "attempt"
      ]
    },
    "BuildReportV5": {
      "type": "object",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "report": {
          "$ref": "#/$defs/BuildReportV1"
        }
      },
      "required": [
        "protocol_version",
        "host_id",
        "report"
      ]
    },
    "CachedImageStateV1": {
      "type": "object",
      "properties": {
        "bytes_on_disk": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_key": {
          "$ref": "#/$defs/ImageKey"
        },
        "image_sha256": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/ImageCachePhase"
        },
        "updated_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "image_key",
        "image_sha256",
        "phase",
        "updated_at_unix_ms"
      ]
    },
    "ClientHelloV5": {
      "type": "object",
      "properties": {
        "agent_version": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/HostCapabilitiesV1"
        },
        "host_id": {
          "type": "string"
        },
        "last_applied_desired_version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/HostRoleV1"
        }
      },
      "required": [
        "protocol_version",
        "host_id",
        "agent_version",
        "role",
        "capabilities"
      ]
    },
    "DesiredBuildV1": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "build_id": {
          "type": "string"
        },
        "bundle_ref": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "kino_version": {
          "type": "string"
        },
        "rev": {
          "type": "string"
        },
        "scenario_id": {
          "type": "string"
        }
      },
      "required": [
        "build_id",
        "scenario_id",
        "arch",
        "rev",
        "content_hash",
        "bundle_ref",
        "kino_version"
      ]
    },
    "DesiredCachedImageV1": {
      "type": "object",
      "properties": {
        "image_key": {
          "$ref": "#/$defs/ImageKey"
        },
        "image_sha256": {
          "type": "string"
        }
      },
      "required": [
        "image_key",
        "image_sha256"
      ]
    },
    "DesiredStateV5": {
      "type": "object",
      "properties": {
        "desired_state": {
          "$ref": "#/$defs/HostDesiredStateV1"
        },
        "host_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "protocol_version",
        "host_id",
        "desired_state"
      ]
    },
    "DesiredVmPhase": {
      "type": "string",
      "enum": [
        "running",
        "absent"
      ]
    },
    "DesiredVmV1": {
      "type": "object",
      "properties": {
        "desired_phase": {
          "$ref": "#/$defs/DesiredVmPhase"
        },
        "image_key": {
          "$ref": "#/$defs/ImageKey"
        },
        "image_sha256": {
          "type": "string"
        },
        "lease_expires_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "resources": {
          "$ref": "#/$defs/VmResourcesV1"
        },
        "run_id": {
          "type": "string"
        },
        "ssh_authorized_keys_openssh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vm_name": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "vm_name",
        "desired_phase",
        "image_key",
        "image_sha256",
        "resources",
        "ssh_authorized_keys_openssh",
        "lease_expires_at_unix_ms"
      ]
    },
    "HostCapabilitiesV1": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "supports_kvm": {
          "type": "boolean"
        },
        "supports_nftables": {
          "type": "boolean"
        },
        "supports_reflink": {
          "type": "boolean"
        },
        "supports_vsock": {
          "type": "boolean"
        }
      },
      "required": [
        "arch",
        "supports_kvm",
        "supports_vsock",
        "supports_reflink",
        "supports_nftables"
      ]
    },
    "HostCapacityV1": {
      "type": "object",
      "properties": {
        "cpu_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "disk_available_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "disk_total_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "memory_available_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "memory_total_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "cpu_count",
        "memory_total_mib",
        "memory_available_mib",
        "disk_total_mib",
        "disk_available_mib"
      ]
    },
    "HostDesiredStateV1": {
      "type": "object",
      "properties": {
        "builds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DesiredBuildV1"
          }
        },
        "cached_images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DesiredCachedImageV1"
          }
        },
        "generated_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "host_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "vms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DesiredVmV1"
          }
        }
      },
      "required": [
        "schema_version",
        "host_id",
        "version",
        "generated_at_unix_ms",
        "cached_images",
        "vms",
        "builds"
      ]
    },
    "HostRoleV1": {
      "type": "string",
      "enum": [
        "agent",
        "builder"
      ]
    },
    "HostStateReportV1": {
      "type": "object",
      "properties": {
        "applied_desired_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "builds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BuildReportV1"
          }
        },
        "cached_images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CachedImageStateV1"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/HostCapabilitiesV1"
        },
        "capacity": {
          "$ref": "#/$defs/HostCapacityV1"
        },
        "host_id": {
          "type": "string"
        },
        "observed_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "vms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VmActualStateV1"
          }
        }
      },
      "required": [
        "schema_version",
        "host_id",
        "observed_at_unix_ms",
        "applied_desired_version",
        "capacity",
        "capabilities",
        "cached_images",
        "vms",
        "builds"
      ]
    },
    "ImageArchitecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "ImageCachePhase": {
      "type": "string",
      "enum": [
        "missing",
        "queued",
        "downloading",
        "ready",
        "failed"
      ]
    },
    "ImageKey": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "scenario": {
          "type": "string"
        },
        "vm": {
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "vm",
        "arch"
      ]
    },
    "ProbePhase": {
      "type": "string",
      "enum": [
        "boot",
        "scenario"
      ]
    },
    "ServerHelloV5": {
      "type": "object",
      "properties": {
        "desired_version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "host_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "protocol_version",
        "host_id",
        "desired_version"
      ]
    },
    "StateReportV5": {
      "type": "object",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "report": {
          "$ref": "#/$defs/HostStateReportV1"
        }
      },
      "required": [
        "protocol_version",
        "host_id",
        "report"
      ]
    },
    "SyncRequestReason": {
      "type": "string",
      "enum": [
        "connect",
        "reconnect",
        "desired_version_lag",
        "operator_requested"
      ]
    },
    "SyncRequestV5": {
      "type": "object",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "reason": {
          "$ref": "#/$defs/SyncRequestReason"
        }
      },
      "required": [
        "protocol_version",
        "host_id",
        "reason"
      ]
    },
    "VmActualStateV1": {
      "type": "object",
      "properties": {
        "archive": {
          "anyOf": [
            {
              "$ref": "#/$defs/VmArchiveStateV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "desired_version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/VmNetworkStateV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "$ref": "#/$defs/VmPhase"
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VmProbeSnapshotV1"
          }
        },
        "run_id": {
          "type": "string"
        },
        "ssh_host_keys_openssh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updated_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "vm_name": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "vm_name",
        "phase",
        "ssh_host_keys_openssh",
        "probes",
        "updated_at_unix_ms"
      ]
    },
    "VmArchivePhase": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "uploading",
        "complete",
        "failed"
      ]
    },
    "VmArchiveStateV1": {
      "type": "object",
      "properties": {
        "artifact_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/VmArchivePhase"
        }
      },
      "required": [
        "phase",
        "artifact_count"
      ]
    },
    "VmNetworkStateV1": {
      "type": "object",
      "properties": {
        "bridge_name": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "guest_cidr": {
          "type": "string"
        },
        "guest_ip": {
          "type": "string"
        },
        "ssh_host_port": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "bridge_name",
        "guest_ip",
        "guest_cidr",
        "gateway"
      ]
    },
    "VmPhase": {
      "type": "string",
      "enum": [
        "pending",
        "pulling_image",
        "creating_disks",
        "booting",
        "running",
        "ready",
        "solved",
        "stopping",
        "stopped",
        "failed",
        "absent"
      ]
    },
    "VmProbeSnapshotV1": {
      "type": "object",
      "properties": {
        "checked_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/ProbePhase"
        },
        "status": {
          "$ref": "#/$defs/VmProbeStatus"
        },
        "value": true
      },
      "required": [
        "id",
        "phase",
        "status",
        "checked_at_unix_ms"
      ]
    },
    "VmProbeStatus": {
      "type": "string",
      "enum": [
        "unknown",
        "pass",
        "fail"
      ]
    },
    "VmReportV1": {
      "type": "object",
      "properties": {
        "archive": {
          "anyOf": [
            {
              "$ref": "#/$defs/VmArchiveStateV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "desired_version": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "host_id": {
          "type": "string"
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/VmNetworkStateV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "phase": {
          "$ref": "#/$defs/VmPhase"
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VmProbeSnapshotV1"
          }
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "ssh_host_keys_openssh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vm_name": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "host_id",
        "run_id",
        "vm_name",
        "observed_at_unix_ms",
        "phase",
        "ssh_host_keys_openssh",
        "probes"
      ]
    },
    "VmReportV5": {
      "type": "object",
      "properties": {
        "host_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "report": {
          "$ref": "#/$defs/VmReportV1"
        }
      },
      "required": [
        "protocol_version",
        "host_id",
        "report"
      ]
    },
    "VmResourcesV1": {
      "type": "object",
      "properties": {
        "cpu_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "disk_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "memory_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "cpu_count",
        "memory_mib",
        "disk_mib"
      ]
    }
  }
}
