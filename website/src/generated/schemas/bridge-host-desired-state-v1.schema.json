{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostDesiredStateV1",
  "type": "object",
  "properties": {
    "builds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DesiredBuildV1"
      }
    },
    "cached_images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DesiredCachedImageV1"
      }
    },
    "generated_at_unix_ms": {
      "type": "integer",
      "format": "int64"
    },
    "host_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "vms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DesiredVmV1"
      }
    }
  },
  "required": [
    "schema_version",
    "host_id",
    "version",
    "generated_at_unix_ms",
    "cached_images",
    "vms",
    "builds"
  ],
  "$defs": {
    "DesiredBuildV1": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "build_id": {
          "type": "string"
        },
        "bundle_ref": {
          "type": "string"
        },
        "content_hash": {
          "type": "string"
        },
        "kino_version": {
          "type": "string"
        },
        "rev": {
          "type": "string"
        },
        "scenario_id": {
          "type": "string"
        }
      },
      "required": [
        "build_id",
        "scenario_id",
        "arch",
        "rev",
        "content_hash",
        "bundle_ref",
        "kino_version"
      ]
    },
    "DesiredCachedImageV1": {
      "type": "object",
      "properties": {
        "image_key": {
          "$ref": "#/$defs/ImageKey"
        },
        "image_sha256": {
          "type": "string"
        }
      },
      "required": [
        "image_key",
        "image_sha256"
      ]
    },
    "DesiredVmPhase": {
      "type": "string",
      "enum": [
        "running",
        "absent"
      ]
    },
    "DesiredVmV1": {
      "type": "object",
      "properties": {
        "desired_phase": {
          "$ref": "#/$defs/DesiredVmPhase"
        },
        "image_key": {
          "$ref": "#/$defs/ImageKey"
        },
        "image_sha256": {
          "type": "string"
        },
        "lease_expires_at_unix_ms": {
          "type": "integer",
          "format": "int64"
        },
        "resources": {
          "$ref": "#/$defs/VmResourcesV1"
        },
        "run_id": {
          "type": "string"
        },
        "ssh_authorized_keys_openssh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vm_name": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "vm_name",
        "desired_phase",
        "image_key",
        "image_sha256",
        "resources",
        "ssh_authorized_keys_openssh",
        "lease_expires_at_unix_ms"
      ]
    },
    "ImageArchitecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "ImageKey": {
      "type": "object",
      "properties": {
        "arch": {
          "$ref": "#/$defs/ImageArchitecture"
        },
        "scenario": {
          "type": "string"
        },
        "vm": {
          "type": "string"
        }
      },
      "required": [
        "scenario",
        "vm",
        "arch"
      ]
    },
    "VmResourcesV1": {
      "type": "object",
      "properties": {
        "cpu_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "disk_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "memory_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "cpu_count",
        "memory_mib",
        "disk_mib"
      ]
    }
  }
}
