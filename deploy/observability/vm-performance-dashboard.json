    {
      "title": "Boot samples",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "Completed boots with structured phase timings; this is not an active VM count.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"intar-agent\"} |= \"vm booted\" | json sample=\"fields.total_ms\" | sample!=\"\" | __error__=\"\" [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "maxLines": 100
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No samples",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "left",
        "orientation": "horizontal",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "valueSize": 36
        }
      },
      "id": 2
    },
