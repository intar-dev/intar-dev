            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.75, {service_name=\"intar-web\"} |= \"type=web-vitals\" |= \" lcp=\" | logfmt | unwrap lcp | __error__=\"\" [$__range]) by ()",
