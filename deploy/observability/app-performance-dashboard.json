    {
      "title": "Slow app requests",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "description": "Matching server spans slower than 500 ms. This is a search sample, not an exhaustive ranking.",
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "editorMode": "code",
          "query": "{ resource.service.name = \"intar-dev\" && span:kind = server && span:duration > 500ms }",
          "queryType": "traceql",
          "metricsQueryType": "range",
          "step": "1m",
          "limit": 25,
          "tableType": "traces"
        }
      ],
