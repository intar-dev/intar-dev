    {
      "title": "Top rejected SSH sources",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "description": "Sources parsed from SSH messages containing \u201cfrom IP\u201d. PAM-only messages can be absent from this ranking.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (source_ip) (count_over_time({service_name=~\"ssh|sshd|linux-auth\"} | host_name=~\"${host:regex}\" |~ \"Failed password|Failed publickey|Invalid user|authentication failure\" | regexp \"from (?P<source_ip>[0-9a-fA-F:.]+)\" | source_ip!=\"\" [$__range])))",
          "legendFormat": "{{source_ip}}",
          "queryType": "instant",
          "maxLines": 100
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No samples",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FFB357"
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Records",
            "desc": true
          }
        ]
      },
      "id": 9,
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "source_ip": "Source IP",
              "Value #A": "Records"
            },
            "indexByName": {
              "source_ip": 0,
              "Value #A": 1
            }
          }
        }
      ]
    },
